datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id          String         @id @default(uuid())
  username    String         @unique
  password    String
  role        String         @default("STUDENT") // "STUDENT" | "ADMIN"
  recoveryCodeHash String?   // one-time password-reset code (scrypt, like passwords); null = none
  publicProfile    Boolean   @default(false) // opt-in: /u/<username> shows stats, badges, certificates
  createdAt   DateTime       @default(now())

  // DPDP (lib/privacy.ts). Month and year of birth only: enough to tell whether a parent must consent.
  birthYear         Int?
  birthMonth        Int?      // 1-12
  guardianStatus    String    @default("none") // "none" (adult) | "pending" | "granted"
  guardianAllowAi   Boolean   @default(false)  // the parent allowed the AI tutor
  // sha256 of the parent link's token (24 random bytes, so an index is enough: a unique
  // constraint makes `prisma db push` stop on a data-loss warning for existing rows)
  guardianTokenHash String?
  guardianTokenExp  DateTime? // the link's expiry before a parent has consented; null after
  consentVersion    String?   // lib/privacy.ts CONSENT_VERSION accepted; null = asked at next visit
  consentAt         DateTime?
  nomineeName       String?   // the person who may exercise this user's rights (DPDP s.14)
  nomineeContact    String?
  guardianConsents  GuardianConsent[]

  // Relations
  progress    UserProgress[]
  xp          UserXp?
  submissions Submission[]
  sessions    Session[]
  ownedClasses     Classroom[]   @relation("OwnedClasses")
  classMemberships ClassMember[]
  sharedDesigns    SharedDesign[]
  projects         Project[]
  certificates     Certificate[]
  comments         Comment[]

  @@index([guardianTokenHash])
}

// ============================================================================
// QUESTIONS / PROBLEMS
// ============================================================================

model Question {
  id                  String   @id @default(uuid())
  slug                String   @unique
  title               String
  difficulty          String   // "Easy" | "Medium" | "Hard" | "Expert"
  category            String   // "FSM" | "Combinational" | "Sequential" etc.
  tags                String   // JSON stringified string[]
  learningLevel       String   // "Beginner" | "Intermediate" | "Advanced" | "Arena"
  orderIndex          Int
  moduleId            String

  // Content
  statement           String   // Markdown
  constraints         String   // JSON stringified string[]
  examples            String   // JSON stringified ProblemExample[]
  hints               String   // JSON stringified Hint[]
  solutionExplanation String?  // Markdown
  editorial           String?  // Markdown by an admin; shown only to solvers (lib/discussion.ts)

  // Code
  starterCode         String
  testbenchSkeleton   String?  // For Arena (user writes testbench)
  publicTestbench     String
  hiddenTestcases     String   // JSON stringified Testcase[]
  hiddenTestbench     String?
  dataFiles           String?  // JSON {filename: content}: extra input files, e.g. a $readmemh hex file
  referenceSolution   String?  // Verified correct design (testbench problems: model testbench); never sent to clients
  problemType         String   @default("design") // "design" | "testbench" (student writes tb.v for a given DUT)
  mutants             String?  // testbench problems: JSON Mutant[] (lib/mutants.ts) the model testbench catches; never sent to clients
  unlockAfter         String?  // slug that must be solved first: a "find the bug" problem is one edit from that problem's answer (lib/unlock.ts)
  publicTestcases     String   // JSON stringified Testcase[]

  // Evaluation
  expectedOutputMode  String   @default("stdout_compare")
  waveformRequired    Boolean  @default(false)

  // Rewards
  xpReward            Int      @default(300)
  xpBonusNoHints      Int?

  // Timestamps
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  progress            UserProgress[]
  submissions         Submission[]
  comments            Comment[]
}

// ============================================================================
// USER PROGRESS (Learning Path)
// ============================================================================

model UserProgress {
  id            String    @id @default(uuid())
  userId        String
  problemId     String    // References Question.id

  // Status
  solved        Boolean   @default(false)
  attempts      Int       @default(0)
  firstSolvedAt DateTime?
  xpEarned      Int       @default(0)
  hintsUnlocked String    @default("[]") // JSON stringified number[]

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

// ============================================================================
// USER XP & MODULE UNLOCKS
// ============================================================================

model UserXp {
  id              String   @id @default(uuid())
  userId          String   @unique
  totalXp         Int      @default(0)
  unlockedModules String   @default("[\"mod_logic_gates\", \"mod_arithmetic\"]")
  lastDailyBonus  String?  // UTC date (YYYY-MM-DD) the daily-challenge bonus was last awarded
  dailyStreak     Int      @default(0) // consecutive days the daily bonus was claimed, as of lastDailyBonus
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// SUBMISSIONS — Critical for LLM Training Data Pipeline
// ============================================================================

model Submission {
  id              String   @id @default(uuid())
  userId          String?
  problemId       String   // References Question.id

  // The code user wrote
  designCode      String   // design.v content
  testbenchCode   String   // tb.v content (either public or user-written)
  language        String   @default("verilog") // of the code the learner wrote: "verilog" | "vhdl" | "python" (cocotb)

  // Run type
  submissionType  String   @default("RUN") // "RUN" | "SUBMIT"
  attemptNumber   Int      @default(1)

  // Simulation Results (captured verbatim from backend)
  simStatus       String   // "SUCCESS" | "COMPILE_ERROR" | "RUNTIME_ERROR" | "TIMEOUT"
  simStdout       String?  // Full stdout from iverilog/vvp
  simStderr       String?  // Full stderr
  simExitCode     Int?     // Raw exit code
  durationMs      Int?     // Wall clock time of simulation

  // Testcase Results (per-testcase breakdown)
  testcaseResults String   @default("[]") // JSON: [{id, passed, expected, actual, description}]
  numTestsPassed  Int      @default(0)
  numTestsTotal   Int      @default(0)

  // Waveform (for debugging/analysis)
  waveformVcd     String?  // Base64-encoded VCD if available

  // XP
  xpEarned        Int      @default(0)
  accepted        Boolean  @default(false) // True if ALL hidden testcases pass

  // Optimization scores of accepted SUBMITs (Yosys, 2-input gates + muxes)
  gateCount       Int?
  logicDepth      Int?
  ffBits          Int?
  fmaxMhz         Float?   // timing problems (lib/arena/timing.ts): place-and-route Fmax on an iCE40-HX8K

  // Wrong SUBMITs: shortest differing input sequence vs. the reference, as a text
  // table (lib/grading.ts counterexampleTable). Shown to the AI tutor.
  counterexample  String?

  // Timestamps
  createdAt       DateTime @default(now())

  // Relations
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@index([createdAt])
  @@index([accepted])
  @@index([problemId, accepted, gateCount])
}

// ============================================================================
// SESSIONS (HTTP-only cookie auth)
// ============================================================================

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ============================================================================
// CLASSROOMS — any signed-in user can create a class and teaches it
// (global User.role is unchanged; class roles live on ClassMember)
// ============================================================================

model Classroom {
  id          String        @id @default(uuid())
  name        String
  joinCode    String        @unique
  ownerId     String
  createdAt   DateTime      @default(now())

  owner       User          @relation("OwnedClasses", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ClassMember[]
  assignments Assignment[]
}

model ClassMember {
  id        String    @id @default(uuid())
  classId   String
  userId    String
  role      String    @default("STUDENT") // "TEACHER" | "STUDENT"
  joinedAt  DateTime  @default(now())

  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
}

model Assignment {
  id           String    @id @default(uuid())
  classId      String
  title        String
  dueAt        DateTime
  problemSlugs String    // JSON stringified string[] (Question.slug)
  createdAt    DateTime  @default(now())

  classroom    Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

// ============================================================================
// SHARED SANDBOX DESIGNS — read-only links (/s/[id]) anyone can open and fork
// ============================================================================

model SharedDesign {
  id            String   @id                 // short random slug, e.g. "k3Fq9xZp"
  ownerId       String
  title         String
  designCode    String
  testbenchCode String
  files         String?  // JSON [{name, content}]: more design files (lib/project-files.ts)
  createdAt     DateTime @default(now())

  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// ============================================================================
// PROJECTS — a user's saved Sandbox work (app/api/projects), with its versions
// ============================================================================

model Project {
  id                String   @id @default(uuid())
  ownerId           String
  name              String
  designCode        String
  testbenchCode     String
  files             String?  // JSON [{name, content}]: more design files (lib/project-files.ts)
  designLanguage    String   @default("verilog")
  testbenchLanguage String   @default("verilog")
  pins              String?  // JSON {"<board>:<top>": constraints text} (components/BitstreamTab.tsx)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions          ProjectVersion[]

  @@index([ownerId, updatedAt])
}

// A saved state of a project; autosaves within a couple of minutes share one (lib/projects.ts).
model ProjectVersion {
  id                String   @id @default(uuid())
  projectId         String
  designCode        String
  testbenchCode     String
  files             String?
  designLanguage    String   @default("verilog")
  testbenchLanguage String   @default("verilog")
  pins              String?
  message           String?  // "Saved by you", "Restored ...": set by an explicit save
  createdAt         DateTime @default(now())

  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ============================================================================
// CONTESTS — timed sets of existing problems; standings are computed from
// SUBMIT rows inside [startsAt, endsAt)
// ============================================================================

model Contest {
  id           String   @id @default(uuid())
  title        String
  startsAt     DateTime
  endsAt       DateTime
  problemSlugs String   // JSON stringified string[] (Question.slug)
  createdAt    DateTime @default(now())

  @@index([startsAt])
}

// ============================================================================
// ANALYTICS — cookieless, aggregated page views. No IPs, users or devices:
// one counter per (day, page, referring site). See app/api/analytics.
// ============================================================================

model PageView {
  id       String @id @default(uuid())
  day      String // "YYYY-MM-DD" (UTC)
  path     String // pathname; ids collapsed to ":id"
  referrer String // referring site's host; "" = direct or from this site
  count    Int    @default(0)

  @@unique([day, path, referrer])
  @@index([day])
}

// ============================================================================
// RATE LIMITS — fixed-window counters shared by every server instance
// (serverless functions don't share memory). See lib/rate-limit.ts.
// ============================================================================

model RateLimit {
  key     String   @id // "<prefix>:<user:id | ip:addr | anonymous>"
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// ============================================================================
// ERROR LOG — server and browser errors for the admin page (kept 30 days).
// No request bodies or user data: where it happened and what was thrown.
// ============================================================================

// ============================================================================
// CONTACT — messages from the public form at /contact, read in the admin console
// (Messages tab). Nothing else is done with them.
// ============================================================================

model ContactMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  subject   String
  message   String
  handled   Boolean  @default(false)
  kind      String   @default("general") // "general" | "grievance" (data requests: answer within 90 days)
  resolvedAt DateTime? // set when handled; the row is deleted a year later (lib/privacy.ts)

  @@index([createdAt])
}

// ============================================================================
// DPDP — parent/guardian consent for under-18 accounts, an audit trail kept a
// year (DPDP Rules: logs of processing), and a site-wide notice (breach response).
// ============================================================================

model GuardianConsent {
  id            String    @id @default(uuid())
  userId        String
  guardianName  String
  relationship  String    // "parent" | "guardian"
  adultDeclared Boolean
  allowAi       Boolean
  ipHash        String?   // sha256 of the parent's IP with a server secret: evidence, not tracking
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  actorId   String?  // who did it (null = the system or a parent link)
  action    String   // e.g. "consent.given", "guardian.granted", "account.deleted", "admin.problem.edit"
  targetId  String?  // the user/problem/contest it was about
  detail    String?  // short, no secrets

  @@index([createdAt])
  @@index([targetId])
}

model SiteNotice {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  message   String
  active    Boolean  @default(true)
}

model ErrorLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  source    String // "server" | "client"
  location  String // API route label or page path
  message   String
  stack     String?

  @@index([createdAt])
}

// ============================================================================
// CERTIFICATES — claimed by the learner after solving every problem in a
// track (lib/tracks.ts); public at /c/<id> so they can be shared and verified.
// ============================================================================

model Certificate {
  id       String   @id // short random id used in the public URL
  userId   String
  track    String   // lib/tracks.ts TRACKS[].id
  issuedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, track])
}

// ============================================================================
// DISCUSSION (lib/discussion.ts): solvers only; hidden by an admin or after 3 reports
// ============================================================================

model Comment {
  id         String   @id @default(uuid())
  questionId String
  userId     String
  body       String   // plain text, at most 2000 characters
  hidden     Boolean  @default(false)
  reports    Int      @default(0)
  createdAt  DateTime @default(now())

  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportedBy CommentReport[]

  @@index([questionId, createdAt])
  @@index([reports])
}

model CommentReport {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}
