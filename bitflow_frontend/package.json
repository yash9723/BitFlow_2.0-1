{
  "name": "verilog-sandbox-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-monaco.mjs && next dev",
    "build": "node scripts/copy-monaco.mjs && next build",
    "start": "node scripts/start-with-db.mjs",
    "start:render": "node scripts/start-with-db.mjs",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "check-problems": "tsx scripts/check-problems.ts",
    "import-solutions": "tsx scripts/import-reference-solutions.ts",
    "check-gate-sim": "tsx scripts/gate-sim.check.ts",
    "check-contests": "tsx scripts/contest.check.ts",
    "check-diagnostics": "tsx scripts/diagnostics.check.ts",
    "check-mutants": "tsx scripts/mutants.check.ts",
    "check-waveform-diff": "tsx scripts/waveform-diff.check.ts",
    "check-vhdl-starter": "tsx scripts/vhdl-starter.check.ts",
    "check-bitstream": "tsx scripts/bitstream.check.ts",
    "check-similarity": "tsx scripts/similarity.check.ts",
    "check-radix": "tsx scripts/radix.check.ts",
    "check-plot": "tsx scripts/plot.check.ts",
    "db:export": "tsx scripts/db-transfer.ts export",
    "db:import": "tsx scripts/db-transfer.ts import"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@neondatabase/neon-js": "^0.6.2-beta",
    "@prisma/client": "^5.15.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "axios": "^1.7.2",
    "elkjs": "^0.11.0",
    "html-to-image": "^1.11.11",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.49.0",
    "next": "14.2.3",
    "openai": "^6.39.0",
    "postcss": "^8.4.38",
    "prisma": "^5.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
