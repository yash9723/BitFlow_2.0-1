# .env.example — Copy to .env and set JWT_SECRET before starting BitFlow.
#
#   cp .env.example .env
#
# docker compose reads this file for both services. For local development,
# bitflow_frontend/ needs its own .env with at least DATABASE_URL="file:./dev.db".
#
# Values shown are the defaults built into api/config.py.
# Only set a variable here if you want to OVERRIDE the default.
# Lines starting with # are comments and are ignored.

# ── Simulation timeouts ───────────────────────────────────────────────────────
# How long (seconds) vvp is allowed to run before being killed.
TIMEOUT_SECONDS=30

# Hard ceiling a client may request via the `timeout` field.
MAX_TIMEOUT_SECONDS=120

# Per-run memory, file-size, process and output caps are fixed in api/sandbox.py.

# ── Input limits ─────────────────────────────────────────────────────────────
# Maximum size (bytes) for each uploaded Verilog source file.
# Default: 524288 bytes = 512 KB
MAX_SOURCE_BYTES=524288

# ── API behaviour ─────────────────────────────────────────────────────────────
# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Whether to embed the VCD as base64 in the JSON response.
# Set to false if you intend to serve it as a separate download endpoint.
INCLUDE_VCD_IN_RESPONSE=true

# CORS allowed origins.  Use ["*"] for local dev; restrict in production.
# Format: JSON array of strings.
CORS_ORIGINS=["*"]

# ── Secrets (required) ────────────────────────────────────────────────────────
# Shared by the API and the frontend; signs frontend→API requests.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=
# Or, for split hosting (e.g. Vercel + Render), an ES256 key pair instead of a
# shared secret: JWT_PRIVATE_KEY on the frontend, JWT_PUBLIC_KEY on the API
# (PEM on one line with literal \n). The API then holds nothing secret.

# Split hosting with several identical simulator deployments (e.g. two free Render
# services, each with the same JWT_SECRET / JWT_PUBLIC_KEY): list them all on the
# frontend. Overrides BACKEND_URL; requests are spread across them and fail over.
# BACKEND_URLS=https://bitflow-sim-1.onrender.com,https://bitflow-sim-2.onrender.com
# A stronger host can take a bigger share with |weight (default 1), e.g. an 8x EC2 server:
# BACKEND_URLS=https://sim.example.com|8,https://bitflow-sim-1.onrender.com,https://bitflow-sim-2.onrender.com

# Secret a user must enter to self-register as ADMIN. Leave empty to disable.
ADMIN_SECRET=

# Host port for the API container (docker compose).
# API_PORT=8000

# Simulations run at once per API process; extra requests queue.
# MAX_CONCURRENT_SIMULATIONS=4

# ── VPS / HTTPS (docker compose --profile https) ──────────────────────────────
# DOMAIN=bitflow.example.com   # Caddy gets a Let's Encrypt cert for this name
# HTTPS=true                   # mark session cookies Secure
# FRONTEND_BIND=127.0.0.1      # hide plain-HTTP :3000 so traffic goes via Caddy
# TRUST_PROXY=true             # per-IP rate limits from Caddy's X-Forwarded-For.
#                              # Only with FRONTEND_BIND=127.0.0.1, or clients can fake it.

# ── Public site (sitemap, social previews, legal pages) ───────────────────────
# Baked into static pages at build time: rebuild (up --build) after changing.
# SITE_URL=https://bitflow.example.com   # public origin, no trailing slash
# CONTACT_EMAIL=hello@example.com        # shown on /privacy and /terms

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite in the bitflow-data volume. For Postgres either
#   a) run the bundled one:  docker compose --profile postgres up -d --build
#      DATABASE_URL=postgresql://bitflow:bitflow-local@postgres:5432/bitflow
#      POSTGRES_PASSWORD=bitflow-local   # change both together
#   b) use a hosted one (Neon, etc.): DATABASE_URL=postgresql://...  (+ DIRECT_URL
#      for the non-pooled URL if your provider uses a pooler)
# Moving existing SQLite data: README, "Moving from SQLite to Postgres"
#   (npm run db:export / db:import in the frontend container).

# ── AI assistant (Sandbox) — server-side only, never sent to the browser ─────
# BITFLOW_AI_PROVIDER=openai   # openai | gemini | anthropic | groq
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
