# .env.example — Copy to .env and edit before running the API.
#
#   cp .env.example .env
#
# Values shown are the defaults built into config.py.
# Only set a variable here if you want to OVERRIDE the default.
# Lines starting with # are comments and are ignored.

# ── Docker image ──────────────────────────────────────────────────────────────
# Name and tag of the pre-built Icarus Verilog sandbox image.
# Must match what you passed to `docker build -t`.
DOCKER_IMAGE=verilog-sandbox:latest

# ── Simulation timeouts ───────────────────────────────────────────────────────
# How long (seconds) vvp is allowed to run before being killed.
TIMEOUT_SECONDS=30

# Hard ceiling a client may request via the `timeout` field.
MAX_TIMEOUT_SECONDS=120

# ── Container resource caps ───────────────────────────────────────────────────
# Docker memory limit.  Format: <number><unit>  (b / k / m / g)
MEM_LIMIT=128m

# CPU throttling.  cpu_quota / cpu_period = fraction of one CPU core.
# 50000 / 100000 = 0.5 cores (50 %).
CPU_QUOTA=50000
CPU_PERIOD=100000

# Maximum PIDs inside the container.  Prevents fork bombs.
PIDS_LIMIT=64

# ── Networking ────────────────────────────────────────────────────────────────
# Set to false ONLY for local debugging.  Always true in production.
NETWORK_DISABLED=true

# ── Input limits ─────────────────────────────────────────────────────────────
# Maximum size (bytes) for each uploaded Verilog source file.
# Default: 524288 bytes = 512 KB
MAX_SOURCE_BYTES=524288

# ── API behaviour ─────────────────────────────────────────────────────────────
# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Whether to embed the VCD as base64 in the JSON response.
# Set to false if you intend to serve it as a separate download endpoint.
INCLUDE_VCD_IN_RESPONSE=true

# CORS allowed origins.  Use ["*"] for local dev; restrict in production.
# Format: JSON array of strings.
CORS_ORIGINS=["*"]

# ── Secrets (required) ────────────────────────────────────────────────────────
# Shared by the API and the frontend; signs frontend→API requests.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Secret a user must enter to self-register as ADMIN. Leave empty to disable.
ADMIN_SECRET=

# Host port for the API container (docker compose).
# API_PORT=8000

# Simulations run at once per API process; extra requests queue.
# MAX_CONCURRENT_SIMULATIONS=4

# ── VPS / HTTPS (docker compose --profile https) ──────────────────────────────
# DOMAIN=bitflow.example.com   # Caddy gets a Let's Encrypt cert for this name
# HTTPS=true                   # mark session cookies Secure
# FRONTEND_BIND=127.0.0.1      # hide plain-HTTP :3000 so traffic goes via Caddy
# TRUST_PROXY=true             # per-IP rate limits from Caddy's X-Forwarded-For.
#                              # Only with FRONTEND_BIND=127.0.0.1, or clients can fake it.

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite in the bitflow-data volume. For Postgres either
#   a) run the bundled one:  docker compose --profile postgres up -d --build
#      DATABASE_URL=postgresql://bitflow:bitflow-local@postgres:5432/bitflow
#      POSTGRES_PASSWORD=bitflow-local   # change both together
#   b) use a hosted one (Neon, etc.): DATABASE_URL=postgresql://...  (+ DIRECT_URL
#      for the non-pooled URL if your provider uses a pooler)

# ── AI assistant (Sandbox) — server-side only, never sent to the browser ─────
# BITFLOW_AI_PROVIDER=openai   # openai | gemini | anthropic | groq
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
